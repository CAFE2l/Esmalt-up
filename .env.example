# =============================================================================
# Esmalt-up - Environment Variables
# Fill in the placeholder values below with your real credentials.
# DO NOT commit this file. Copy to .env.local for production secrets if needed.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Cloudinary (image & video uploads)
# https://cloudinary.com/console
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# -----------------------------------------------------------------------------
# Firebase (service account + client credentials)
# https://console.firebase.google.com/project/_/settings/serviceaccounts/adminsdk
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server-side only - never expose NEXT_PUBLIC_)
FIREBASE_SERVICE_ACCOUNT_TYPE=
FIREBASE_SERVICE_ACCOUNT_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY_ID=
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_CLIENT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_CLIENT_ID=

# -----------------------------------------------------------------------------
# Neon (PostgreSQL) - serverless database
# https://console.neon.tech -> your project -> Connect
# -----------------------------------------------------------------------------
# Note: use the pooled connection for serverless apps
DATABASE_URL=

# Prisma (if used)
DIRECT_URL=

# -----------------------------------------------------------------------------
# NextAuth / Auth.js
# https://next-auth.js.org/configuration/options#secret
# -----------------------------------------------------------------------------
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# -----------------------------------------------------------------------------
# Stripe (payments) - optional
# https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=