generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  uid              String   @id
  name             String?
  email            String?
  avatarUrl        String?
  profilePhotoUrl  String?
  bannerUrl        String?
  bio              String?
  isEntrepreneur   Boolean  @default(false)
  services         String[] @default([])
  pricing          String?
  bookingLink      String?
  level            String?
  experienceYears  String?
  favoriteBrands   String?
  favoriteStyles   String?
  equipment        String?
  courseInProgress String?
  city             String?
  status           String?
  interests        String[]
  badges           String[]
  youtube          String?
  instagram        String?
  tiktok           String?
  isAdmin          Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  orders           Order[]
  addresses        Address[]
  progress         CourseProgress[]
  reviews          Review[]
  questions        Question[]
  answers          Answer[]
  cart             Cart?
  notifications    Notification[]
  badgesEarned     UserBadge[]
  lessonProgress   LessonProgress[]
  certificates     Certificate[]
  favorites        Favorite[]

  @@map("user_profiles")
}

model Notification {
  id        String       @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime     @default(now())
  user      UserProfile  @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model UserBadge {
  id        String      @id @default(cuid())
  userId    String
  badgeKey  String
  awardedAt DateTime    @default(now())
  user      UserProfile @relation(fields: [userId], references: [uid], onDelete: Cascade)

  @@unique([userId, badgeKey])
  @@index([userId])
  @@map("user_badges")
}

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  kind            String   // "kit" or "peca"
  name            String
  description     String
  brand           String?
  sku             String?  @unique
  priceCents      Int
  oldPriceCents   Int?
  category        String
  stock           Int      @default(0)
  featured        Boolean  @default(false)
  videoUrl        String?
  images          String[] @default([])
  highlights      String[] @default([])
  specs           Json?
  variants        Json?
  weightG         Int      @default(0)
  heightCm        Int      @default(0)
  widthCm         Int      @default(0)
  lengthCm        Int      @default(0)
  ratingAvg       Float    @default(0)
  ratingCount     Int      @default(0)
  soldCount       Int      @default(0)
  level           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems      OrderItem[]
  reviews         Review[]
  questions       Question[]
  favorites        Favorite[]

  @@index([kind, active])
  @@index([category, active])
  @@index([featured, active])
  @@map("products")
}

model Address {
  id          String      @id @default(cuid())
  userId      String
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  uf          String
  isDefault   Boolean     @default(false)
  user        UserProfile @relation(fields: [userId], references: [uid], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
  @@map("addresses")
}

model CourseModule {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  orderIndex  Int
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("course_modules")
}

model Lesson {
  id                String           @id @default(cuid())
  moduleId          String
  slug              String           @unique
  title             String
  description       String           @default("")
  youtubeVideoId    String?
  youtubePlaylistId String?
  channel           String?
  durationSec       Int?
  orderIndex        Int
  thumbnailUrl      String?
  embeddable        Boolean          @default(true)
  embedError        String?
  isActive          Boolean          @default(true)
  module            CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress          LessonProgress[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([moduleId, orderIndex])
  @@index([youtubeVideoId])
  @@map("lessons")
}

model LessonProgress {
  id                  String      @id @default(cuid())
  userId              String
  lessonId            String
  completedAt         DateTime?
  lastPositionSeconds Int         @default(0)
  user                UserProfile @relation(fields: [userId], references: [uid], onDelete: Cascade)
  lesson              Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

model Order {
  id             String   @id @default(cuid())
  userId         String?
  sessionId      String?
  addressId      String?
  customerName   String?
  email          String?
  cpf            String?
  phone          String?
  kitName        String
  date           DateTime @default(now())
  status         String
  user           UserProfile? @relation(fields: [userId], references: [uid], onDelete: Cascade)
  address        Address?   @relation(fields: [addressId], references: [id])

  subtotalCents  Int      @default(0)
  shippingCents  Int      @default(0)
  discountCents  Int      @default(0)
  totalCents     Int      @default(0)
  couponCode     String?

  paymentMethod  String?
  paymentStatus  String   @default("pending")
  gatewayPaymentId String?
  gatewayStatus  String?
  paymentExtra   String?

  trackingCode   String?
  shippedAt      DateTime?
  deliveredAt    DateTime?

  items          OrderItem[]
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([sessionId])
  @@index([addressId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  priceCents  Int
  quantity    Int
  variant     String?
  product     Product? @relation(fields: [productId], references: [id])
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String?    @unique
  user      UserProfile? @relation(fields: [userId], references: [uid], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())

  @@map("carts")
}

model CartItem {
  id          String  @id @default(cuid())
  cartId      String
  productId   String
  variantId   String?
  variantName String?
  quantity    Int     @default(1)
  cart        Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model Favorite {
  id        String      @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime    @default(now())
  user      UserProfile @relation(fields: [userId], references: [uid], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
  @@map("favorites")
}

model Coupon {
  id        String    @id @default(cuid())
  code      String    @unique
  type      String
  value     Int
  active    Boolean   @default(true)
  minPriceCents Int?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@map("coupons")
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  userId       String?
  userName     String
  rating       Int
  title        String?
  content      String
  verifiedPurchase Boolean @default(false)
  status       String   @default("pending")
  helpfulCount Int      @default(0)
  user         UserProfile? @relation(fields: [userId], references: [uid], onDelete: SetNull)
  product      Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media        ReviewMedia[]
  votes        ReviewVote[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
  @@map("reviews")
}

model ReviewMedia {
  id        String   @id @default(cuid())
  reviewId  String
  kind      String
  url       String
  sortOrder Int      @default(0)
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_media")
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String?
  sessionId String?
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@unique([reviewId, sessionId])
  @@map("review_votes")
}

model Question {
  id        String    @id @default(cuid())
  productId String
  userId    String?
  userName  String
  email     String?
  content   String
  status    String    @default("answered")
  user      UserProfile? @relation(fields: [userId], references: [uid], onDelete: SetNull)
  product   Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  answers   Answer[]
  createdAt DateTime  @default(now())

  @@index([productId])
  @@map("questions")
}

model Answer {
  id           String   @id @default(cuid())
  questionId   String
  userId       String?
  userName     String
  content      String
  isVendor     Boolean  @default(false)
  helpfulCount Int      @default(0)
  user         UserProfile? @relation(fields: [userId], references: [uid], onDelete: SetNull)
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  helpful      AnswerHelpful[]
  createdAt    DateTime @default(now())

  @@map("answers")
}

model AnswerHelpful {
  id       String   @id @default(cuid())
  answerId String
  userId   String?
  sessionId String?
  answer   Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([answerId, userId, sessionId])
  @@map("answer_helpful")
}

model CourseProgress {
  id            String   @id @default(cuid())
  userId        String
  lessonTitle   String
  dateCompleted DateTime @default(now())
  status        String
  user          UserProfile @relation(fields: [userId], references: [uid], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@index([userId])
  @@map("course_progress")
}

model Certificate {
  id              String    @id @default(cuid())
  publicCode      String    @unique
  userId          String
  courseId        String    @default("nail-designer-iniciante")
  recipientName   String
  issuedAt        DateTime  @default(now())
  curriculumVersion Int     @default(1)
  status          String    @default("valid") // "valid" | "revoked"
  showOnWall      Boolean   @default(true) @map("show_on_wall")
  user            UserProfile @relation(fields: [userId], references: [uid], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([publicCode])
  @@index([userId])
  @@index([status])
  @@index([status, showOnWall, issuedAt], map: "certificates_wall_idx")
  @@map("certificates")
}